{
  "rules": {
    "users": {
      ".read": true,
      ".write": true
    },
    "buses": {
      ".read": true,
      ".write": true
    },
    "routes": {
      ".read": true,
      ".write": true
    },
    "locations": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('buses').child($busId).child('assignedDriver').val() === auth.uid || root.child('users').child(auth.uid).child('assignedBus').val() === $busId)"
      }
    },
    "shiftLogs": {
      ".read": true,
      ".write": true
    },
    "attendance": {
      ".read": true,
      ".write": true
    },
    "driverSessions": {
      "$driverUid": {
        ".read": "auth != null && auth.uid === $driverUid",
        ".write": "auth != null && auth.uid === $driverUid"
      }
    },
    "alerts": {
      ".read": true,
      ".write": true
    },
    "driverNotifications": {
      "$driverUid": {
        ".read": "auth != null && (auth.uid === $driverUid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "broadcastNotifications": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'driver' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "adminSentNotifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
