{
  "rules": {
    "users": {
      ".read": true,
      ".write": true
    },
    "buses": {
      ".read": true,
      ".write": true
    },
    "routes": {
      ".read": true,
      ".write": true
    },
    "locations": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('buses').child($busId).child('assignedDriver').val() === auth.uid || root.child('users').child(auth.uid).child('assignedBus').val() === $busId)"
      }
    },
    "shiftLogs": {
      ".read": true,
      ".write": true
    },
    "attendance": {
      ".read": true,
      ".write": true
    },
    "alerts": {
      ".read": true,
      ".write": true
    }
  }
}
